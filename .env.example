# Copy to .env and fill in. Process environment variables override these.
# Any Jira value left blank falls back to the Peer Review App's settings
# (data/config.json + Windows Credential Manager) and then its .env.

# --- Jira (same keys as Peer Review App) ---
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Confluence on the same Atlassian site is searched with the same credentials.
SEARCH_CONFLUENCE=true

# --- Claude (same sign-in as Peer Review App) ---
# cli = Claude Code (WSL first when USE_WSL_CLAUDE=true, else Windows)
# api = Anthropic API; needs ANTHROPIC_API_KEY (or the one saved in Peer Review App)
CLAUDE_MODE=cli
USE_WSL_CLAUDE=true
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_PLAN_MODEL=claude-haiku-4-5-20251001
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MINUTES=10
ANTHROPIC_API_KEY=

# Where the Peer Review App lives (default: sibling folder "Peer Review App").
# PEER_REVIEW_APP_DIR=

# --- GitHub (for "Ask Claude"; same sign-in as the GitHub Code Scanner) ---
# auto = your Git Credential Manager login first, GITHUB_TOKEN as fallback
# git = Git login only; token = GITHUB_TOKEN only
# Blank values fall back to the GitHub Code Scanner's .env.
GITHUB_AUTH=auto
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Where the GitHub Code Scanner lives (default: sibling folder "Github Code Scanner").
# CODE_SCANNER_DIR=

# --- Commit scanning ---
# Repos offered in the Repo dropdown (short names in GITHUB_ORG).
REPO_CHOICES=marketplace,marketplace-search-api,aim-myt,marketplace-ssr,lib-importer-tasks-php
# "Auto" repo picks per Jira project: PROJECT:repo,repo;PROJECT:repo
PROJECT_REPOS=ASEARCH:marketplace,marketplace-search-api
# "Auto" repo picks per site named in the ticket, tried first: term|term:repo,repo;term:repo
# Equipment Trader and Commercial Truck Trader moved to marketplace-ssr.
SITE_REPOS=equip|equipment|equipment trader|equipmenttrader|truck|trucks|commercial truck trader|commercialtrucktrader|ctt:marketplace-ssr

# --- Ticket checks ---
# Find context saves what it gathered per ticket; Ask Claude reuses it while younger than this.
CONTEXT_MAX_AGE_HOURS=24
